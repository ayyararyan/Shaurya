{
  "schema_version": "1.0.0",
  "config_id": "paper-research",
  "credential_handles": [
    {
      "provider": "dhan",
      "handle": "market-data-session",
      "required_fields": ["client_id", "access_token"]
    }
  ],
  "risk_limits": [
    {
      "name": "account_daily_loss",
      "scope": "account",
      "metric": "daily_pnl_rupees",
      "comparison": ">=",
      "threshold": "-2000",
      "unit": "INR",
      "instrument_id": null
    }
  ]
}
