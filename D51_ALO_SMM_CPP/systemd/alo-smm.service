[Unit]
Description=D51 ALO-SMM shadow market maker
After=network-online.target chrony.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/d51-alo-smm
EnvironmentFile=/etc/alo-smm/alo-smm.env
ExecStart=/opt/d51-alo-smm/scripts/run_shadow.sh
Restart=no
# A crash marks the shadow day incomplete; do not silently reset simulated inventory mid-session.
RuntimeMaxSec=6h35m
LimitNOFILE=65536
Nice=-5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/d51-alo-smm/state /opt/d51-alo-smm/stats /opt/d51-alo-smm/logs

[Install]
WantedBy=multi-user.target
