# Never commit this file. Install as /etc/alo-smm/alo-smm.env mode 0600.
KOTAK_CONSUMER_KEY=replace_me
KOTAK_MOBILE=replace_me
KOTAK_UCC=replace_me
# Preferred for unattended startup: base32 secret from the authenticator enrollment.
KOTAK_TOTP_SECRET=replace_me
# Fallback only if you manually launch with a current one-time code:
# KOTAK_TOTP=123456
KOTAK_MPIN=replace_me

# DO NOT SET in shadow month.
# ALO_LIVE_ACK=I_UNDERSTAND_LIVE_ORDERS
# ALO_LIVE_START_FLAT_ACK=I_CONFIRM_ACCOUNT_FLAT
