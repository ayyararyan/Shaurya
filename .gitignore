.DS_Store

# Editor, IDE, and merge-tool leftovers
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.rej
*.orig
!scratch/gap_open_analysis/gate_b_structure_search.py.orig

*.env
.env.*
!.env.example
*.pem
*.ppk
*.key
*.token
*.log
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.nox/
.tox/
.venv/
.ml_venv/
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
compile_commands.json
dist/
*.egg-info/
artifacts/
run/
runs/
state/
logs/
/data/
# Raw captures and generated tables are ignored by default. Curated evidence already tracked in
# docs/results remains versioned, and new result tables there stay visible for deliberate review.
*.jsonl
*.csv
!docs/results/*.csv
*.parquet

# Large local research data / accidental venv under scratch (2026-08-25)
scratch/gap_open_analysis/.ml_venv/
scratch/gap_open_analysis/*.pkl

# D51 ALO-SMM v0.1.1-shadow runtime outputs and local credentials
D51_ALO_SMM_CPP/.env
D51_ALO_SMM_CPP/build/
!D51_ALO_SMM_CPP/state/
D51_ALO_SMM_CPP/state/*
!D51_ALO_SMM_CPP/state/.gitkeep
D51_ALO_SMM_CPP/stats/*
!D51_ALO_SMM_CPP/stats/.gitkeep

# Preserve the delivered package examples/placeholders despite broad repo ignores.
!D51_ALO_SMM_CPP/config/instruments.csv
!D51_ALO_SMM_CPP/config/instruments.example.csv
!D51_ALO_SMM_CPP/logs/
!D51_ALO_SMM_CPP/logs/.gitkeep
