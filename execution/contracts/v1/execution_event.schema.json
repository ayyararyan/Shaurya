{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shaurya.invalid/contracts/v1/execution_event.schema.json",
  "title": "Shaurya ExecutionEvent 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "timestamp_ns", "execution_session_id", "payload"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"$ref": "#/$defs/uuid"},
    "event_type": {"enum": ["market_observation_accepted", "intent_received", "mapping_validated", "mapping_refused", "risk_approved", "risk_rejected", "submission_started", "broker_acknowledged", "partially_filled", "filled", "modify_requested", "modified", "modify_rejected", "cancel_requested", "cancelled", "cancel_rejected", "broker_rejected", "ambiguous_submission", "reconciliation_required", "reconciliation_completed", "safety_stop", "session_started", "session_stopping", "session_stopped", "ledger_repair_recorded"]},
    "timestamp_ns": {"$ref": "#/$defs/int64"},
    "execution_session_id": {"$ref": "#/$defs/uuid"},
    "strategy_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "strategy_run_id": {"$ref": "#/$defs/uuid"},
    "intent_id": {"$ref": "#/$defs/uuid"},
    "internal_order_id": {"$ref": "#/$defs/uuid"},
    "payload": {"type": "object", "maxProperties": 128}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "int64": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
    "uint64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "text128": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[ -~]+$"},
    "empty_or_session_payload": {"type": "object", "additionalProperties": false, "properties": {"mode": {"enum": ["shadow"]}, "build_digest": {"$ref": "#/$defs/digest"}, "routing_snapshot_digest": {"$ref": "#/$defs/digest"}, "state": {"type": "string", "minLength": 1, "maxLength": 32}, "reason": {"type": "string", "minLength": 1, "maxLength": 128}, "launch_attestation_digest": {"$ref": "#/$defs/digest"}, "invocation_id": {"$ref": "#/$defs/uuid"}, "operator_id": {"$ref": "#/$defs/text128"}, "device_id": {"$ref": "#/$defs/text128"}, "public_key_fingerprint": {"$ref": "#/$defs/text128"}, "cli_release_digest": {"$ref": "#/$defs/digest"}, "deployment_manifest_digest": {"$ref": "#/$defs/digest"}, "executor_build_digest": {"$ref": "#/$defs/digest"}, "requested_mode": {"const": "shadow"}, "confirmation_type": {"const": "SHAURYA_SHADOW_LAUNCH"}, "launch_timestamp_ns": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}}, "dependentRequired": {"launch_attestation_digest": ["invocation_id", "operator_id", "device_id", "public_key_fingerprint", "cli_release_digest", "deployment_manifest_digest", "executor_build_digest", "requested_mode", "confirmation_type", "launch_timestamp_ns"], "invocation_id": ["launch_attestation_digest"], "operator_id": ["launch_attestation_digest"], "device_id": ["launch_attestation_digest"], "public_key_fingerprint": ["launch_attestation_digest"], "cli_release_digest": ["launch_attestation_digest"], "deployment_manifest_digest": ["launch_attestation_digest"], "executor_build_digest": ["launch_attestation_digest"], "requested_mode": ["launch_attestation_digest"], "confirmation_type": ["launch_attestation_digest"], "launch_timestamp_ns": ["launch_attestation_digest"]}},
    "intent_payload": {"type": "object", "additionalProperties": false, "required": ["semantic_fingerprint"], "properties": {"semantic_fingerprint": {"$ref": "#/$defs/digest"}, "canonical_instrument_id": {"type": "string", "minLength": 1, "maxLength": 192}}},
    "market_observation_evidence_payload": {"type": "object", "additionalProperties": false, "required": ["best_ask_paise", "best_bid_paise", "canonical_instrument_id", "cumulative_volume", "last_trade_paise", "provenance", "receive_timestamp_ns", "source", "source_digest", "source_sequence"], "properties": {"best_ask_paise": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}]}, "best_bid_paise": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}]}, "canonical_instrument_id": {"type": "string", "minLength": 1, "maxLength": 192}, "cumulative_volume": {"$ref": "#/$defs/uint64"}, "last_trade_paise": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}]}, "provenance": {"const": "observed"}, "receive_timestamp_ns": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}, "source": {"const": "dhan"}, "source_digest": {"$ref": "#/$defs/digest"}, "source_sequence": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}}},
    "submission_payload": {"type": "object", "additionalProperties": false, "required": ["canonical_instrument_id", "route_digest", "side", "quantity", "limit_price_paise"], "properties": {"baseline_cumulative_volume": {"$ref": "#/$defs/uint64"}, "canonical_instrument_id": {"type": "string", "minLength": 1, "maxLength": 192}, "route_digest": {"$ref": "#/$defs/digest"}, "side": {"enum": ["BUY", "SELL"]}, "quantity": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}, "limit_price_paise": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}, "broker": {"type": "string", "minLength": 1, "maxLength": 32}, "attempt_sequence": {"$ref": "#/$defs/uint64"}}},
    "ack_payload": {"type": "object", "additionalProperties": false, "required": ["update_id", "broker_order_id", "source_sequence", "source_fingerprint", "source_provenance"], "properties": {"update_id": {"$ref": "#/$defs/text128"}, "broker_order_id": {"$ref": "#/$defs/text128"}, "provenance": {"enum": ["simulated", "proxy", "simulated_proxy", "broker_confirmed"]}, "instrument_token": {"type": "string", "minLength": 1, "maxLength": 64}, "quantity": {"$ref": "#/$defs/uint64"}, "limit_price_paise": {"$ref": "#/$defs/uint64"}, "source_sequence": {"$ref": "#/$defs/uint64"}, "source_fingerprint": {"$ref": "#/$defs/digest"}, "source_provenance": {"enum": ["simulated", "proxy", "simulated_proxy", "broker_confirmed"]}}},
    "fill_payload": {"type": "object", "additionalProperties": false, "required": ["update_id", "cumulative_filled_quantity", "source_sequence", "source_fingerprint", "source_provenance"], "properties": {"update_id": {"$ref": "#/$defs/text128"}, "broker_order_id": {"$ref": "#/$defs/text128"}, "cumulative_filled_quantity": {"$ref": "#/$defs/uint64"}, "fill_price_paise": {"$ref": "#/$defs/uint64"}, "provenance": {"enum": ["simulated", "proxy", "simulated_proxy", "broker_confirmed"]}, "instrument_token": {"type": "string", "minLength": 1, "maxLength": 64}, "evidence_timestamp_ns": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}, "source_sequence": {"$ref": "#/$defs/uint64"}, "source_fingerprint": {"$ref": "#/$defs/digest"}, "source_provenance": {"enum": ["simulated", "proxy", "simulated_proxy", "broker_confirmed"]}}},
    "mapping_payload": {"type": "object", "additionalProperties": false, "required": ["routing_snapshot_digest", "instrument_token", "exchange_segment", "trading_symbol", "lot_size", "tick_size_paise"], "properties": {"canonical_instrument_id": {"type": "string", "minLength": 1, "maxLength": 192}, "routing_snapshot_digest": {"$ref": "#/$defs/digest"}, "instrument_token": {"type": "string", "minLength": 1, "maxLength": 64}, "exchange_segment": {"const": "nse_fo"}, "trading_symbol": {"$ref": "#/$defs/text128"}, "lot_size": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}, "tick_size_paise": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}}},
    "mapping_refused_payload": {"type": "object", "additionalProperties": false, "required": ["error_code"], "properties": {"error_code": {"type": "string", "minLength": 1, "maxLength": 64}, "routing_snapshot_digest": {"$ref": "#/$defs/digest"}}},
    "risk_approved_payload": {"type": "object", "additionalProperties": false, "required": ["broker_call_count", "decision_id", "configuration_digest", "risk_decision"], "properties": {"broker_call_count": {"const": 0}, "decision_id": {"$ref": "#/$defs/uuid"}, "configuration_digest": {"$ref": "#/$defs/digest"}, "risk_decision": {"type": "object", "maxProperties": 16}}},
    "risk_rejected_payload": {"type": "object", "additionalProperties": false, "required": ["broker_call_count", "decision_id", "configuration_digest", "rejection_code", "risk_decision"], "properties": {"broker_call_count": {"const": 0}, "decision_id": {"$ref": "#/$defs/uuid"}, "configuration_digest": {"$ref": "#/$defs/digest"}, "rejection_code": {"type": "string", "minLength": 1, "maxLength": 64}, "risk_decision": {"type": "object", "maxProperties": 16}}},
    "update_payload": {"type": "object", "additionalProperties": false, "required": ["update_id"], "properties": {"update_id": {"$ref": "#/$defs/text128"}, "broker_order_id": {"$ref": "#/$defs/text128"}, "provenance": {"enum": ["simulated", "proxy", "simulated_proxy", "broker_confirmed"]}, "source_sequence": {"$ref": "#/$defs/uint64"}, "source_fingerprint": {"$ref": "#/$defs/digest"}, "source_provenance": {"enum": ["simulated", "proxy", "simulated_proxy", "broker_confirmed"]}}},
    "modify_payload": {"type": "object", "additionalProperties": false, "required": ["update_id", "quantity", "limit_price_paise"], "properties": {"update_id": {"$ref": "#/$defs/text128"}, "quantity": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}, "limit_price_paise": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}, "provenance": {"enum": ["simulated", "proxy", "simulated_proxy", "broker_confirmed"]}, "source_sequence": {"$ref": "#/$defs/uint64"}, "source_fingerprint": {"$ref": "#/$defs/digest"}, "source_provenance": {"enum": ["simulated", "proxy", "simulated_proxy", "broker_confirmed"]}}},
    "error_update_payload": {"type": "object", "additionalProperties": false, "required": ["update_id", "error_code", "source_sequence", "source_fingerprint", "source_provenance"], "properties": {"update_id": {"$ref": "#/$defs/text128"}, "error_code": {"type": "string", "minLength": 1, "maxLength": 64}, "provenance": {"enum": ["simulated", "proxy", "simulated_proxy", "broker_confirmed"]}, "source_sequence": {"$ref": "#/$defs/uint64"}, "source_fingerprint": {"$ref": "#/$defs/digest"}, "source_provenance": {"enum": ["simulated", "proxy", "simulated_proxy", "broker_confirmed"]}}},
    "reconciliation_payload": {"type": "object", "additionalProperties": false, "properties": {"reason": {"$ref": "#/$defs/text128"}, "error_code": {"type": "string", "minLength": 1, "maxLength": 64}, "update_id": {"$ref": "#/$defs/text128"}, "broker_order_id": {"$ref": "#/$defs/text128"}, "cumulative_filled_quantity": {"$ref": "#/$defs/uint64"}, "authoritative_state": {"type": "string", "minLength": 1, "maxLength": 32}}},
    "safety_payload": {"type": "object", "additionalProperties": false, "properties": {"reason": {"$ref": "#/$defs/text128"}, "error_code": {"type": "string", "minLength": 1, "maxLength": 64}, "queue": {"type": "string", "minLength": 1, "maxLength": 64}, "stage": {"type": "string", "minLength": 1, "maxLength": 64}}},
    "repair_payload": {"type": "object", "additionalProperties": false, "required": ["confirmation_type", "damaged_segment_bytes", "damaged_segment_sha256", "repair_tool_version", "source_label", "verified_prefix_bytes"], "properties": {"confirmation_type": {"const": "REPAIR_TRUNCATED_LEDGER"}, "damaged_segment_bytes": {"$ref": "#/$defs/uint64"}, "damaged_segment_sha256": {"$ref": "#/$defs/digest"}, "repair_tool_version": {"type": "string", "minLength": 1, "maxLength": 16}, "source_label": {"$ref": "#/$defs/text128"}, "verified_prefix_bytes": {"$ref": "#/$defs/uint64"}}}
  },
  "allOf": [
    {"if": {"properties": {"event_type": {"const": "market_observation_accepted"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/market_observation_evidence_payload"}}, "not": {"anyOf": [{"required": ["strategy_id"]}, {"required": ["strategy_run_id"]}, {"required": ["intent_id"]}, {"required": ["internal_order_id"]}]}}},
    {"if": {"properties": {"event_type": {"enum": ["session_started", "session_stopping", "session_stopped"]}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/empty_or_session_payload"}}, "not": {"anyOf": [{"required": ["strategy_id"]}, {"required": ["strategy_run_id"]}, {"required": ["intent_id"]}, {"required": ["internal_order_id"]}]}}},
    {"if": {"properties": {"event_type": {"const": "ledger_repair_recorded"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/repair_payload"}}, "not": {"anyOf": [{"required": ["strategy_id"]}, {"required": ["strategy_run_id"]}, {"required": ["intent_id"]}, {"required": ["internal_order_id"]}]}}},
    {"if": {"properties": {"event_type": {"const": "intent_received"}}}, "then": {"required": ["strategy_id", "strategy_run_id", "intent_id"], "not": {"required": ["internal_order_id"]}, "properties": {"payload": {"$ref": "#/$defs/intent_payload"}}}},
    {"if": {"properties": {"event_type": {"const": "submission_started"}}}, "then": {"required": ["strategy_id", "strategy_run_id", "intent_id", "internal_order_id"], "properties": {"payload": {"$ref": "#/$defs/submission_payload"}}}},
    {"if": {"properties": {"event_type": {"const": "broker_acknowledged"}}}, "then": {"required": ["strategy_id", "strategy_run_id", "intent_id", "internal_order_id"], "properties": {"payload": {"$ref": "#/$defs/ack_payload"}}}},
    {"if": {"properties": {"event_type": {"enum": ["partially_filled", "filled"]}}}, "then": {"required": ["strategy_id", "strategy_run_id", "intent_id", "internal_order_id"], "properties": {"payload": {"$ref": "#/$defs/fill_payload"}}}},
    {"if": {"properties": {"event_type": {"const": "mapping_validated"}}}, "then": {"required": ["strategy_id", "strategy_run_id", "intent_id", "internal_order_id"], "properties": {"payload": {"$ref": "#/$defs/mapping_payload"}}}},
    {"if": {"properties": {"event_type": {"const": "mapping_refused"}}}, "then": {"required": ["strategy_id", "strategy_run_id", "intent_id"], "not": {"required": ["internal_order_id"]}, "properties": {"payload": {"$ref": "#/$defs/mapping_refused_payload"}}}},
    {"if": {"properties": {"event_type": {"const": "risk_approved"}}}, "then": {"required": ["strategy_id", "strategy_run_id", "intent_id", "internal_order_id"], "properties": {"payload": {"$ref": "#/$defs/risk_approved_payload"}}}},
    {"if": {"properties": {"event_type": {"const": "risk_rejected"}}}, "then": {"required": ["strategy_id", "strategy_run_id", "intent_id"], "not": {"required": ["internal_order_id"]}, "properties": {"payload": {"$ref": "#/$defs/risk_rejected_payload"}}}},
    {"if": {"properties": {"event_type": {"enum": ["cancel_requested", "cancelled"]}}}, "then": {"required": ["strategy_id", "strategy_run_id", "intent_id", "internal_order_id"], "properties": {"payload": {"$ref": "#/$defs/update_payload"}}}},
    {"if": {"properties": {"event_type": {"enum": ["modify_requested", "modified"]}}}, "then": {"required": ["strategy_id", "strategy_run_id", "intent_id", "internal_order_id"], "properties": {"payload": {"$ref": "#/$defs/modify_payload"}}}},
    {"if": {"properties": {"event_type": {"enum": ["modify_rejected", "cancel_rejected"]}}}, "then": {"required": ["strategy_id", "strategy_run_id", "intent_id", "internal_order_id"], "properties": {"payload": {"$ref": "#/$defs/error_update_payload"}}}},
    {"if": {"properties": {"event_type": {"enum": ["broker_rejected", "ambiguous_submission"]}}}, "then": {"required": ["strategy_id", "strategy_run_id", "intent_id", "internal_order_id"], "properties": {"payload": {"$ref": "#/$defs/error_update_payload"}}}},
    {"if": {"properties": {"event_type": {"enum": ["reconciliation_required", "reconciliation_completed"]}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/reconciliation_payload"}}}},
    {"if": {"properties": {"event_type": {"const": "safety_stop"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/safety_payload"}}}}
  ]
}
