{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shaurya.invalid/contracts/v1/order_intent.schema.json",
  "title": "Shaurya OrderIntent 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent_id", "strategy_id", "strategy_run_id", "execution_session_id", "created_at_ns", "expires_at_ns", "canonical_instrument_id", "action"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "intent_id": {"$ref": "#/$defs/uuid"},
    "strategy_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "strategy_run_id": {"$ref": "#/$defs/uuid"},
    "execution_session_id": {"$ref": "#/$defs/uuid"},
    "created_at_ns": {"$ref": "#/$defs/int64"},
    "expires_at_ns": {"$ref": "#/$defs/int64"},
    "canonical_instrument_id": {"$ref": "#/$defs/instrument"},
    "action": {"enum": ["place", "modify", "cancel"]},
    "side": {"enum": ["BUY", "SELL"]},
    "quantity": {"$ref": "#/$defs/positive_uint64"},
    "limit_price_paise": {"$ref": "#/$defs/positive_uint64"},
    "product": {"const": "NRML"},
    "time_in_force": {"const": "DAY"},
    "target_internal_order_id": {"$ref": "#/$defs/uuid"},
    "strategy_tag": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "int64": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
    "positive_uint64": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "instrument": {"type": "string", "maxLength": 192, "pattern": "^NSE:NSE_FNO:[A-Z0-9][A-Z0-9._-]{0,63}:(future:[0-9]{4}-[0-9]{2}-[0-9]{2}|option:[0-9]{4}-[0-9]{2}-[0-9]{2}:[1-9][0-9]*(\\.[0-9]*[1-9])?:(CE|PE))$"}
  },
  "allOf": [
    {"if": {"properties": {"action": {"const": "place"}}}, "then": {"required": ["side", "quantity", "limit_price_paise", "product", "time_in_force"], "not": {"required": ["target_internal_order_id"]}}},
    {"if": {"properties": {"action": {"const": "modify"}}}, "then": {"required": ["side", "quantity", "limit_price_paise", "product", "time_in_force", "target_internal_order_id"]}},
    {"if": {"properties": {"action": {"const": "cancel"}}}, "then": {"required": ["target_internal_order_id"], "not": {"anyOf": [{"required": ["side"]}, {"required": ["quantity"]}, {"required": ["limit_price_paise"]}, {"required": ["product"]}, {"required": ["time_in_force"]}]}}}
  ]
}
