{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shaurya.invalid/contracts/v1/market_observation.schema.json",
  "title": "Shaurya MarketObservation 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonical_instrument_id", "cumulative_volume", "exchange_timestamp_ns", "receive_timestamp_ns", "source", "provenance", "quality_flags"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "canonical_instrument_id": {"$ref": "#/$defs/instrument"},
    "best_bid_paise": {"$ref": "#/$defs/positive_uint64"},
    "best_ask_paise": {"$ref": "#/$defs/positive_uint64"},
    "last_trade_paise": {"$ref": "#/$defs/positive_uint64"},
    "cumulative_volume": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "exchange_timestamp_ns": {"anyOf": [{"$ref": "#/$defs/int64"}, {"type": "null"}]},
    "receive_timestamp_ns": {"$ref": "#/$defs/int64"},
    "source": {"const": "dhan"},
    "provenance": {"enum": ["observed", "simulated", "proxy"]},
    "quality_flags": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"enum": ["stale", "crossed_book", "partial_book", "source_sequence_unavailable", "coalesced_update", "unusable"]}}
  },
  "$defs": {
    "int64": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
    "positive_uint64": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "instrument": {"type": "string", "maxLength": 192, "pattern": "^NSE:NSE_FNO:[A-Z0-9][A-Z0-9._-]{0,63}:(future:[0-9]{4}-[0-9]{2}-[0-9]{2}|option:[0-9]{4}-[0-9]{2}-[0-9]{2}:[1-9][0-9]*(\\.[0-9]*[1-9])?:(CE|PE))$"}
  }
}
