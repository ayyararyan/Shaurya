{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shaurya.invalid/execution/routing_manifest_schema_v1.json",
  "additionalProperties": false,
  "properties": {
    "bytes": {"maximum": 16777216, "minimum": 1, "type": "integer"},
    "exporter_version": {"const": "1.0.0"},
    "record_count": {"maximum": 4096, "minimum": 1, "type": "integer"},
    "requested_universe_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "schema_version": {"const": "1.0.0"},
    "snapshot_file": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$", "type": "string"},
    "snapshot_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "sources": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {"additionalProperties": false, "properties": {"broker": {"const": "dhan"}, "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}}, "required": ["broker", "sha256"], "type": "object"},
        {"additionalProperties": false, "properties": {"broker": {"const": "kotak"}, "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}}, "required": ["broker", "sha256"], "type": "object"}
      ],
      "type": "array"
    },
    "trading_date": {"format": "date", "type": "string"}
  },
  "required": ["bytes", "exporter_version", "record_count", "requested_universe_sha256", "schema_version", "snapshot_file", "snapshot_sha256", "sources", "trading_date"],
  "type": "object"
}
