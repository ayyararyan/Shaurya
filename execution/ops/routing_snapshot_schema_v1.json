{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shaurya.invalid/execution/routing_snapshot_schema_v1.json",
  "additionalProperties": false,
  "properties": {
    "records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "canonical_instrument_id": {"maxLength": 200, "pattern": "^NSE:NSE_FNO:[A-Z0-9][A-Z0-9._-]{0,63}:(future:[0-9]{4}-[0-9]{2}-[0-9]{2}|option:[0-9]{4}-[0-9]{2}-[0-9]{2}:[0-9]+(\\.[0-9]+)?:[CP]E)$", "type": "string"},
          "exchange_segment": {"const": "nse_fo"},
          "instrument_token": {"pattern": "^[A-Za-z0-9._-]{1,64}$", "type": "string"},
          "lot_size": {"maximum": 9223372036854775807, "minimum": 1, "type": "integer"},
          "tick_size_paise": {"maximum": 9223372036854775807, "minimum": 1, "type": "integer"},
          "trading_symbol": {"pattern": "^[A-Za-z0-9._&-]{1,128}$", "type": "string"}
        },
        "required": ["canonical_instrument_id", "exchange_segment", "instrument_token", "lot_size", "tick_size_paise", "trading_symbol"],
        "type": "object"
      },
      "maxItems": 4096,
      "minItems": 1,
      "type": "array"
    },
    "requested_universe_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "schema_version": {"const": "1.0.0"},
    "sources": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {"additionalProperties": false, "properties": {"broker": {"const": "dhan"}, "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}}, "required": ["broker", "sha256"], "type": "object"},
        {"additionalProperties": false, "properties": {"broker": {"const": "kotak"}, "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}}, "required": ["broker", "sha256"], "type": "object"}
      ],
      "type": "array"
    },
    "trading_date": {"format": "date", "type": "string"}
  },
  "required": ["records", "requested_universe_sha256", "schema_version", "sources", "trading_date"],
  "type": "object"
}
