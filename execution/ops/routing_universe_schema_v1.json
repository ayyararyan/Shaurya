{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shaurya.invalid/execution/routing_universe_schema_v1.json",
  "additionalProperties": false,
  "properties": {
    "canonical_instrument_ids": {
      "items": {"maxLength": 200, "pattern": "^NSE:NSE_FNO:[A-Z0-9][A-Z0-9._-]{0,63}:(future:[0-9]{4}-[0-9]{2}-[0-9]{2}|option:[0-9]{4}-[0-9]{2}-[0-9]{2}:[0-9]+(\\.[0-9]+)?:[CP]E)$", "type": "string"},
      "maxItems": 4096,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "dhan_master_as_of_date": {"format": "date", "type": "string"},
    "kotak_master_as_of_date": {"format": "date", "type": "string"},
    "schema_version": {"const": "1.0.0"},
    "trading_date": {"format": "date", "type": "string"}
  },
  "required": ["canonical_instrument_ids", "dhan_master_as_of_date", "kotak_master_as_of_date", "schema_version", "trading_date"],
  "type": "object"
}
